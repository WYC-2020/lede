From 8ccdd3711b49c5a558637e8ad0bcca1a3ae25dfc Mon Sep 17 00:00:00 2001
From: W_Y_CPP <383152993@qq.com>
Date: Mon, 8 Jan 2024 03:22:02 -0500
Subject: [PATCH] netfilter-flowtable-Set-offload-timeouts-according-t

---
 include/net/netfilter/nf_flow_table.h |  2 ++
 net/netfilter/nf_flow_table_core.c    | 41 ++++++++++++++++++++++-----
 net/netfilter/nf_flow_table_ip.c      |  4 +--
 3 files changed, 38 insertions(+), 9 deletions(-)

--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -80,6 +80,8 @@ struct flow_offload {
 
 #define NF_FLOW_TIMEOUT (30 * HZ)
 
+unsigned long flow_offload_get_timeout(struct flow_offload *flow);
+
 struct nf_flow_route {
 	struct {
 		struct dst_entry	*dst;
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -109,8 +109,6 @@ static void flow_offload_fixup_tcp(struc
 	tcp->seen[1].td_maxwin = 0;
 }
 
-#define NF_FLOWTABLE_TCP_PICKUP_TIMEOUT	(120 * HZ)
-#define NF_FLOWTABLE_UDP_PICKUP_TIMEOUT	(30 * HZ)
 
 static inline __s32 nf_flow_timeout_delta(unsigned int timeout)
 {
@@ -120,6 +118,7 @@ static inline __s32 nf_flow_timeout_delt
 static void flow_offload_fixup_ct_timeout(struct nf_conn *ct)
 {
 	const struct nf_conntrack_l4proto *l4proto;
+	struct net *net = nf_ct_net(ct);
 	int l4num = nf_ct_protonum(ct);
 	unsigned int timeout;
 
@@ -127,10 +126,14 @@ static void flow_offload_fixup_ct_timeou
 	if (!l4proto)
 		return;
 
-	if (l4num == IPPROTO_TCP)
-		timeout = NF_FLOWTABLE_TCP_PICKUP_TIMEOUT;
-	else if (l4num == IPPROTO_UDP)
-		timeout = NF_FLOWTABLE_UDP_PICKUP_TIMEOUT;
+	if (l4num == IPPROTO_TCP){
+		struct nf_tcp_net *tn = nf_tcp_pernet(net);
+		timeout = tn->offload_pickup;
+	}
+	else if (l4num == IPPROTO_UDP){
+		struct nf_udp_net *tn = nf_udp_pernet(net);
+		timeout = tn->offload_pickup;
+	}
 	else
 		return;
 
@@ -216,12 +219,40 @@ static void nf_ct_offload_timeout(struct
 		ct->timeout = nfct_time_stamp + DAY;
 }
 
+unsigned long flow_offload_get_timeout(struct flow_offload *flow)
+{
+	const struct nf_conntrack_l4proto *l4proto;
+	struct flow_offload_entry *entry;
+	struct nf_conn *ct;
+	entry = container_of(flow, struct flow_offload_entry, flow);
+	ct = entry->ct;
+	unsigned long timeout = NF_FLOW_TIMEOUT;
+	struct net *net = nf_ct_net(ct);
+	int l4num = nf_ct_protonum(ct);
+
+	l4proto = nf_ct_l4proto_find(l4num);
+	if (!l4proto)
+		return timeout;
+
+	if (l4num == IPPROTO_TCP) {
+		struct nf_tcp_net *tn = nf_tcp_pernet(net);
+
+		timeout = tn->offload_timeout;
+	} else if (l4num == IPPROTO_UDP) {
+		struct nf_udp_net *tn = nf_udp_pernet(net);
+
+		timeout = tn->offload_timeout;
+	}
+
+	return timeout;
+}
+
 int flow_offload_add(struct nf_flowtable *flow_table, struct flow_offload *flow)
 {
 	int err;
 
 	nf_ct_offload_timeout(flow);
-	flow->timeout = (u32)jiffies + NF_FLOW_TIMEOUT;
+	flow->timeout = (u32)jiffies + flow_offload_get_timeout(flow);
 
 	err = rhashtable_insert_fast(&flow_table->rhashtable,
 				     &flow->tuplehash[0].node,
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -281,7 +281,7 @@ nf_flow_offload_ip_hook(void *priv, stru
 	if (nf_flow_nat_ip(flow, skb, thoff, dir) < 0)
 		return NF_DROP;
 
-	flow->timeout = (u32)jiffies + NF_FLOW_TIMEOUT;
+	flow->timeout = (u32)jiffies + flow_offload_get_timeout(flow);
 	iph = ip_hdr(skb);
 	ip_decrease_ttl(iph);
 	skb->tstamp = 0;
@@ -511,7 +511,7 @@ nf_flow_offload_ipv6_hook(void *priv, st
 	if (nf_flow_nat_ipv6(flow, skb, dir) < 0)
 		return NF_DROP;
 
-	flow->timeout = (u32)jiffies + NF_FLOW_TIMEOUT;
+	flow->timeout = (u32)jiffies + flow_offload_get_timeout(flow);
 	ip6h = ipv6_hdr(skb);
 	ip6h->hop_limit--;
 	skb->tstamp = 0;
