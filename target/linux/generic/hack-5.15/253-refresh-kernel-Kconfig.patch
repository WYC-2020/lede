From f33933397bb0281b0f4d2bdeb521826673b1a044 Mon Sep 17 00:00:00 2001
From: W_Y_CPP <383152993@qq.com>
Date: Tue, 22 Feb 2022 21:52:05 -0500
Subject: [PATCH] refresh kernel Kconfig

---
 crypto/Kconfig             | 2 +-
 drivers/usb/gadget/Kconfig | 2 +-
 drivers/usb/host/Kconfig   | 2 +-
 drivers/usb/serial/Kconfig | 2 +-
 init/Kconfig               | 2 +-
 lib/Kconfig                | 8 ++++----
 virt/lib/Kconfig           | 2 +-
 7 files changed, 10 insertions(+), 10 deletions(-)

--- a/crypto/Kconfig
+++ b/crypto/Kconfig
@@ -3,7 +3,7 @@
 # Generic algorithms support
 #
 config XOR_BLOCKS
-	tristate
+	tristate "Xor blocks"
 
 #
 # async_tx api: hardware offloaded memory transfer/transform support
--- a/drivers/usb/gadget/Kconfig
+++ b/drivers/usb/gadget/Kconfig
@@ -143,7 +143,7 @@ source "drivers/usb/gadget/udc/Kconfig"
 
 # composite based drivers
 config USB_LIBCOMPOSITE
-	tristate
+	tristate "Libcomposite"
 	select CONFIGFS_FS
 	depends on USB_GADGET
 
--- a/drivers/usb/host/Kconfig
+++ b/drivers/usb/host/Kconfig
@@ -183,7 +183,7 @@ config USB_EHCI_TT_NEWSCHED
 if USB_EHCI_HCD
 
 config USB_EHCI_PCI
-	tristate
+	tristate "USB ehci PCI"
 	depends on USB_PCI
 	default y
 
--- a/drivers/usb/serial/Kconfig
+++ b/drivers/usb/serial/Kconfig
@@ -540,7 +540,7 @@ config USB_SERIAL_CYBERJACK
 	  If unsure, say N.
 
 config USB_SERIAL_WWAN
-	tristate
+	tristate "USB serial WAN"
 
 config USB_SERIAL_OPTION
 	tristate "USB driver for GSM and CDMA modems"
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -2388,7 +2388,7 @@ config PADATA
 	bool
 
 config ASN1
-	tristate
+	tristate "Ans1"
 	help
 	  Build a simple ASN.1 grammar compiler that produces a bytecode output
 	  that can be interpreted by the ASN.1 stream decoder and used to
--- a/lib/Kconfig
+++ b/lib/Kconfig
@@ -9,7 +9,7 @@ config BINARY_PRINTF
 menu "Library routines"
 
 config RAID6_PQ
-	tristate
+	tristate "Raid6_PQ"
 
 config RAID6_PQ_BENCHMARK
 	bool "Automatically choose fastest RAID6 PQ functions"
@@ -302,10 +302,10 @@ config 842_DECOMPRESS
 	tristate
 
 config ZLIB_INFLATE
-	tristate
+	tristate "Zlib inflate"
 
 config ZLIB_DEFLATE
-	tristate
+	tristate "Zlib deflate"
 	select BITREVERSE
 
 config ZLIB_DFLTCC
@@ -614,7 +614,7 @@ config LIBFDT
 	bool
 
 config OID_REGISTRY
-	tristate
+	tristate "Oid registry"
 	help
 	  Enable fast lookup object identifier registry.
 
@@ -730,4 +730,4 @@ config PLDMFW
 	default n
 
 config ASN1_ENCODER
-       tristate
+       tristate "asn1 encoder"
--- a/virt/lib/Kconfig
+++ b/virt/lib/Kconfig
@@ -1,3 +1,3 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config IRQ_BYPASS_MANAGER
-	tristate
+	tristate "IRQ offload/bypass manager"
--- a/drivers/bluetooth/Kconfig
+++ b/drivers/bluetooth/Kconfig
@@ -8,7 +8,7 @@ config BT_INTEL
 	select REGMAP
 
 config BT_BCM
-	tristate
+	tristate "Bluetooth support for Broadcom devices"
 	select FW_LOADER
 
 config BT_RTL
