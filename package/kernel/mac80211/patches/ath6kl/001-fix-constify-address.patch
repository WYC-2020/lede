From 5e2d692ee058b64245fb3e178a3f9d28f6be2ddf Mon Sep 17 00:00:00 2001
From: W_Y_CPP <383152993@qq.com>
Date: Wed, 20 Jul 2022 13:25:09 +0800
Subject: [PATCH] fix constify address

---
 drivers/net/wireless/ath/ath6kl/cfg80211.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/ath/ath6kl/cfg80211.c b/drivers/net/wireless/ath/ath6kl/cfg80211.c
index 1dca244..9abfe00 100644
--- a/drivers/net/wireless/ath/ath6kl/cfg80211.c
+++ b/drivers/net/wireless/ath/ath6kl/cfg80211.c
@@ -3781,7 +3781,7 @@ struct wireless_dev *ath6kl_interface_add(struct ath6kl *ar, const char *name,
 {
 	struct net_device *ndev;
 	struct ath6kl_vif *vif;
-
+	u8 dev_addr[ETH_ALEN];
 	ndev = alloc_netdev(sizeof(*vif), name, name_assign_type, ether_setup);
 	if (!ndev)
 		return NULL;
@@ -3803,15 +3803,19 @@ struct wireless_dev *ath6kl_interface_add(struct ath6kl *ar, const char *name,
 	vif->htcap[NL80211_BAND_2GHZ].ht_enable = true;
 	vif->htcap[NL80211_BAND_5GHZ].ht_enable = true;
 
-	memcpy(ndev->dev_addr, ar->mac_addr, ETH_ALEN);
+	memcpy(dev_addr, ar->mac_addr, ETH_ALEN);
 	if (fw_vif_idx != 0) {
-		ndev->dev_addr[0] = (ndev->dev_addr[0] ^ (1 << fw_vif_idx)) |
+		dev_addr[0] = (dev_addr[0] ^ (1 << fw_vif_idx)) |
 				     0x2;
 		if (test_bit(ATH6KL_FW_CAPABILITY_CUSTOM_MAC_ADDR,
 			     ar->fw_capabilities))
-			ndev->dev_addr[4] ^= 0x80;
+			dev_addr[4] ^= 0x80;
 	}
-
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 0)
+	eth_hw_addr_set(ndev, dev_addr);
+#else
+	memcpy(ndev->dev_addr, dev_addr, ETH_ALEN);
+#endif
 	init_netdev(ndev);
 
 	ath6kl_init_control_info(vif);
-- 
2.17.1

